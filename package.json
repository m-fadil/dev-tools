{
  "name": "@m-fadil/dev-tools",
  "version": "0.2.0",
  "private": true,
  "description": "Modular developer CLI for repository maintenance",
  "type": "module",
  "repository": "github:m-fadil/dev-tools",
  "bin": {
    "dt": "dist/src/cli.js"
  },
  "files": [
    "dist/src"
  ],
  "engines": {
    "node": "^22.13.0 || >=23.5.0"
  },
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "npm run clean && npm run build && node --test dist/test/*.test.js",
    "start": "node dist/src/cli.js",
    "prepare": "npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@inquirer/prompts": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0"
  }
}
